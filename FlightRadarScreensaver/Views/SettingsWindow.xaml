<Window x:Class="FlightRadarScreensaver.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlightRadar Screensaver — Настройки"
        Width="460" Height="470"
        MinWidth="460" MinHeight="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F2F2F7"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════ Шапка ═══════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E4" BorderThickness="0,0,0,1">
            <Grid Margin="22,16,22,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                        Background="#0A84FF" Margin="0,0,13,0" VerticalAlignment="Center">
                    <TextBlock Text="FR" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="FlightRadar Screensaver" FontSize="16" FontWeight="SemiBold" Foreground="#1C1C1E" />
                    <TextBlock Text="Живая карта полётов · OpenSky Network" FontSize="11.5" Foreground="#6E6E73" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════ Контент ═══════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,4">
            <StackPanel>

                <!-- ── Координаты ── -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Координаты центра карты" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Долгота" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LonTextBox"
                                         Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="От −180 до 180, например 37.6176" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Широта" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LatTextBox"
                                         Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="От −90 до 90, например 55.7558" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource HintText}" Margin="0,9,0,0"
                                   Text="Координаты вводятся вручную, точка или запятая допустимы." />
                    </StackPanel>
                </Border>

                <!-- ── Масштаб ── -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Масштаб карты" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock x:Name="ZoomValueText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#0A84FF" />
                        </Grid>

                        <Slider x:Name="ZoomSlider" Minimum="3" Maximum="15" TickFrequency="1"
                                Value="{Binding Zoom}" Margin="0,2,0,4" />

                        <Grid>
                            <TextBlock Text="Континент" Style="{StaticResource HintText}" HorizontalAlignment="Left" />
                            <TextBlock Text="Район города" Style="{StaticResource HintText}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Отображение ── -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Отображение самолётов" Style="{StaticResource SectionHeader}" />
                        <CheckBox x:Name="ShowLabelsCheck" Content="Показывать позывные"
                                  IsChecked="{Binding ShowLabels}" Margin="0,0,0,8" />
                        <CheckBox x:Name="ShowTrailsCheck" Content="Показывать следы полётов"
                                  IsChecked="{Binding ShowTrails}" />
                    </StackPanel>
                </Border>

                <Border Background="#EAF3FF" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource HintText}" Foreground="#00549E"
                               Text="Данные: OpenSky Network (открытый API, обновление раз в 30 секунд). Для самолётов нужен интернет." />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════ Кнопки ═══════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E4" BorderThickness="0,1,0,0">
            <Grid Margin="22,14,22,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Проверить" Style="{StaticResource AccentButton}"
                        Click="TestButton_Click" ToolTip="Открыть заставку в отдельном окне" />

                <Button Grid.Column="2" Content="Отмена" Click="CancelButton_Click" />
                <Button Grid.Column="4" Content="Сохранить" Style="{StaticResource SuccessButton}"
                        Click="SaveButton_Click" MinWidth="112" />
            </Grid>
        </Border>
    </Grid>
</Window>